VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# The store's WhatsApp number in international format, digits only. After checkout the
# shopper is sent to a wa.me chat with this number, prefilled with their order.
VITE_WHATSAPP_ADMIN_NUMBER=233244000000

# Add these only as Supabase Edge Function secrets, never to VITE_ variables:
# WHATSAPP_ACCESS_TOKEN
# WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_VERIFY_TOKEN
# WHATSAPP_APP_SECRET
# WHATSAPP_ADMIN_RECIPIENT
